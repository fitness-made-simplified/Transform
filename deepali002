<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FMS | Deepali's Training Protocol</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');
        * { box-sizing: border-box; }
        body {
            background-color: #050505; color: #ffffff; font-family: 'Inter', sans-serif;
            margin: 0; padding: 24px; padding-bottom: 64px; -webkit-tap-highlight-color: transparent;
        }
        a { text-decoration: none; color: inherit; }

        .glass {
            background: rgba(255, 255, 255, 0.03);
            -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
        }

        header { margin-bottom: 24px; }
        .back-link {
            color: #f43f5e; font-weight: 900; text-transform: uppercase; font-size: 10px;
            letter-spacing: 0.15em; margin-bottom: 24px; display: block;
        }
        h1 { font-size: 36px; font-weight: 900; text-transform: uppercase; font-style: italic; line-height: 1; margin: 0; }
        .subtitle { font-size: 10px; font-weight: 900; text-transform: uppercase; color: #737373; letter-spacing: 0.2em; margin-top: 12px; }

        .note-card {
            padding: 20px; margin-bottom: 32px;
            border-left: 4px solid #f59e0b; background: rgba(245,158,11,0.06);
        }
        .note-card p:first-child { color: #f59e0b; }
        .note-text { font-size: 12px; color: #d4d4d4; font-style: italic; line-height: 1.6; margin: 8px 0 0; }

        .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 32px; }
        .stat-box { padding: 16px; }
        .stat-value { font-size: 14px; font-weight: 900; font-style: italic; text-transform: uppercase; margin: 4px 0 0; }

        .stat-label { font-size: 8px; font-weight: 900; text-transform: uppercase; color: #737373; letter-spacing: 0.1em; margin: 0; }

        .day-list { display: flex; flex-direction: column; gap: 16px; }
        .phase-card {
            padding: 24px; cursor: pointer;
            border-left: 4px solid rgba(255,255,255,0.05);
            transition: all 0.3s ease;
        }
        .phase-card.active { border-left: 4px solid #e11d48; background: rgba(225, 29, 72, 0.05); }
        .phase-head { display: flex; justify-content: space-between; align-items: center; }
        .phase-day-label { font-size: 8px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 4px; color: #f43f5e; }
        .phase-day-label.caution { color: #f59e0b; }
        .phase-title { font-size: 20px; font-weight: 900; text-transform: uppercase; font-style: italic; line-height: 1; margin: 0; }
        .chevron { transition: transform 0.3s ease; color: #e11d48; flex-shrink: 0; }
        .phase-card.active .chevron { transform: rotate(180deg); }
        .phase-card:not(.active) .phase-content { max-height: 0; opacity: 0; overflow: hidden; padding-top: 0; }
        .phase-card.active .phase-content { max-height: 3000px; opacity: 1; padding-top: 16px; transition: all 0.4s ease; }

        .circuit-label {
            font-size: 9px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.15em;
            color: #f43f5e; margin: 16px 0 0; padding-bottom: 4px;
            border-bottom: 1px solid rgba(225,29,72,0.25);
        }
        .circuit-label:first-child { margin-top: 0; }
        .rest-text { font-size: 12px; color: #a3a3a3; font-style: italic; line-height: 1.6; margin: 0; padding: 12px 0; }

        .exercise-row {
            padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.06);
            display: flex; align-items: center; justify-content: space-between; gap: 12px;
        }
        .exercise-row:last-child { border-bottom: none; }
        .ex-name { font-size: 13px; font-weight: 700; color: #f5f5f5; margin: 0; }
        .ex-rx { font-size: 10px; color: #737373; text-transform: uppercase; font-weight: 700; letter-spacing: 0.1em; margin: 4px 0 0; }
        .yt-btn {
            flex-shrink: 0; display: flex; align-items: center; gap: 4px;
            background: rgba(225,29,72,0.12); border: 1px solid rgba(225,29,72,0.25);
            padding: 8px 12px; border-radius: 8px; font-size: 9px; font-weight: 900;
            text-transform: uppercase; color: #fb7185;
        }
        .yt-btn:active { transform: scale(0.95); }

        .cta-btn {
            width: 100%; margin-top: 32px; padding: 16px; border-radius: 16px;
            font-weight: 900; text-transform: uppercase; font-size: 14px; letter-spacing: 0.1em;
            display: flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, #e11d48 0%, #9f1239 100%); color: #fff;
        }
        .cta-btn:active { transform: scale(0.97); }
    </style>
</head>
<body>

    <header>
        <a href="profile.html?id=Deepali" class="back-link">← Exit Protocol</a>
        <h1>Deepali</h1>
        <p class="subtitle">Coached By Sushant · FMS</p>
    </header>

    <div class="glass note-card">
        <p class="stat-label" style="color:#f59e0b">⚠ Coach Note</p>
        <p class="note-text">Week 1 — focus on strict form and a steady rhythm before chasing speed or load. On the 600 rep days, break the reps into as many sets as you need to hit the target. Stop any movement that causes sharp or pinching pain and report it to Coach Sushant.</p>
    </div>

    <div class="stat-grid">
        <div class="glass stat-box">
            <p class="stat-label">Split</p>
            <p class="stat-value">6 Day Fat Loss</p>
        </div>
        <div class="glass stat-box">
            <p class="stat-label">Phase</p>
            <p class="stat-value" style="color:#f43f5e">Week 1</p>
        </div>
    </div>

    <div id="protocolContainer" class="day-list"></div>

    <a href="https://wa.me/919899550279?text=Hi%20Coach%20Sushant!%20I%20have%20a%20question%20about%20my%20workout%20plan." class="cta-btn">
        Message Coach Sushant
    </a>

    <script>
        function ytLink(name) {
            const q = encodeURIComponent(name + ' correct form tutorial');
            return `https://www.youtube.com/results?search_query=${q}`;
        }

        function exerciseRow(name, prescription, query) {
            return `
            <div class="exercise-row">
                <div>
                    <p class="ex-name">${name}</p>
                    <p class="ex-rx">${prescription}</p>
                </div>
                <a href="${ytLink(query || name)}" target="_blank" class="yt-btn">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg> Form
                </a>
            </div>`;
        }

        // A string item = circuit / section label. An array item = [name, prescription, youtubeQuery]
        const days = [
            {
                title: 'Day 1 · Monday', subtitle: 'HIIT',
                exercises: [
                    'Warm Up',
                    ['Treadmill Brisk Walk', '1 km', 'treadmill brisk walking'],
                    'Circuit A · 3 Rounds',
                    ['Squat Press', '15 reps', 'dumbbell squat to press'],
                    ['Jump Squats', '15 reps', 'jump squats'],
                    ['Donkey Kicks', '15 reps', 'donkey kicks'],
                    'Strength · 3 Sets Each',
                    ['Chest Press Machine', '15 reps x 3 sets', 'chest press machine'],
                    ['Lat Pulldown', '15 reps x 3 sets', 'lat pulldown'],
                    'Circuit B · 3 Rounds',
                    ['Dumbbell Shoulder Press', '15 reps', 'dumbbell shoulder press'],
                    ['Dumbbell Curl', '15 reps', 'dumbbell bicep curl'],
                    ['Overhead Extension', '15 reps', 'dumbbell overhead triceps extension'],
                    'Core + Finisher',
                    ['Sit Ups + Leg Raises', '10 reps x 3 sets', 'sit ups and leg raises'],
                    ['Cross Trainer', '10 mins', 'cross trainer elliptical'],
                ]
            },
            {
                title: 'Day 2', subtitle: 'All Body Weight',
                exercises: [
                    'Warm Up',
                    ['Cross Trainer', '10 mins', 'cross trainer elliptical'],
                    'Circuit A · 3 Rounds',
                    ['Lunges', '15 reps each leg', 'bodyweight lunges'],
                    ['Standing Side Kicks', '15 reps', 'standing side kicks exercise'],
                    ['Burpees', '10 reps', 'burpees'],
                    'Circuit B · 3 Rounds',
                    ['Mountain Climbers', '25 reps each side', 'mountain climbers'],
                    ['Fire Hydrants', '15 reps each side', 'fire hydrant exercise'],
                    'Circuit C · 3 Rounds',
                    ['Jumping Jacks', '50 reps', 'jumping jacks'],
                    ['Tricep Dips', '20 reps', 'bench tricep dips'],
                    ['Sumo Squats', '15 reps', 'sumo squat'],
                    'Circuit D · 3 Rounds',
                    ['Plank Hold', '30 seconds', 'plank hold'],
                    ['Dead Bugs', '15 reps each side', 'dead bug exercise'],
                ]
            },
            {
                title: 'Day 3', subtitle: 'Steady Pace Cardio',
                exercises: [
                    ['Steady Pace Cardio', '5 km target in 45 mins', 'steady state cardio'],
                ]
            },
            {
                title: 'Day 4', subtitle: 'Upper Body · 600 Rep Target',
                exercises: [
                    'Warm Up',
                    ['Treadmill Brisk Walk', '1 km', 'treadmill brisk walking'],
                    '600 Rep Target · 10 Exercises x 60 Reps',
                    ['Bench Press', '60 reps', 'barbell bench press'],
                    ['Lat Pulldown', '60 reps', 'lat pulldown'],
                    ['Dumbbell Curl', '60 reps', 'dumbbell bicep curl'],
                    ['Pulley Push Down', '60 reps', 'cable triceps pushdown'],
                    ['Shoulder Press Machine', '60 reps', 'shoulder press machine'],
                    ['Chest Fly Machine', '60 reps', 'pec deck chest fly machine'],
                    ['Seated Row', '60 reps', 'seated cable row'],
                    ['Pulley Curl', '60 reps', 'cable bicep curl'],
                    ['Tricep Dips', '60 reps', 'bench tricep dips'],
                    ['Barbell Row', '60 reps', 'barbell bent over row'],
                ]
            },
            {
                title: 'Day 5', subtitle: 'Rest Day',
                rest: true,
                restText: 'Recovery day — no structured workout today.',
                exercises: []
            },
            {
                title: 'Day 6', subtitle: 'Lower Body · 600 Rep Target',
                exercises: [
                    'Warm Up',
                    ['Lower Body Warm Up', 'Light cardio + mobility', 'lower body workout warm up'],
                    '600 Rep Target · 10 Exercises x 60 Reps',
                    ['Leg Extension Machine', '60 reps', 'leg extension machine'],
                    ['Leg Curl Machine', '60 reps', 'leg curl machine'],
                    ['Lunges', '60 reps each leg', 'dumbbell lunges'],
                    ['Squats (Weighted)', '60 reps', 'weighted squats'],
                    ['Sumo Squats (Weighted)', '60 reps', 'weighted sumo squat'],
                    ['Donkey Kicks', '60 reps each leg', 'donkey kicks'],
                    ['Fire Hydrants', '60 reps each side', 'fire hydrant exercise'],
                    ['Lying Side Kicks', '60 reps each side', 'lying side leg raise kicks'],
                    ['Jump Squats', '60 reps', 'jump squats'],
                    ['Calf Raises', '60 reps', 'standing calf raise'],
                ]
            },
        ];

        function renderContent(d) {
            if (d.rest) return `<p class="rest-text">${d.restText}</p>`;
            return d.exercises.map(item =>
                typeof item === 'string'
                    ? `<p class="circuit-label">${item}</p>`
                    : exerciseRow(item[0], item[1], item[2])
            ).join('');
        }

        const container = document.getElementById('protocolContainer');
        container.innerHTML = days.map((d, i) => `
            <div class="glass phase-card ${i === 0 ? 'active' : ''}" onclick="this.classList.toggle('active')">
                <div class="phase-head">
                    <div>
                        <p class="phase-day-label ${d.caution ? 'caution' : ''}">${d.title}${d.caution ? ' · Light Load' : ''}</p>
                        <h3 class="phase-title">${d.subtitle}</h3>
                    </div>
                    <svg class="chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg>
                </div>
                <div class="phase-content">
                    ${renderContent(d)}
                </div>
            </div>
        `).join('');
    </script>
</body>
</html>
